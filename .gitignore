# ── Dependencies ────────────────────────────────────────────────────
/vendor
/node_modules

# ── Environment & secrets ───────────────────────────────────────────
.env
.env.*
!.env.example
/auth.json

# ── Build output / runtime ──────────────────────────────────────────
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/.phpunit.cache
.phpunit.result.cache
# Note: public/assets/store/css/*.css (compiled storefront themes) IS committed
# so the site works without a build step — rebuild with `npm run store:css`.

# ── User uploads (product photos, logos, payment receipts) ──────────
# Demo product images are regenerated by `php artisan db:seed`.
/public/uploads/*
!/public/uploads/.gitkeep

# ── Logs ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# ── Local tooling & editors ─────────────────────────────────────────
/.claude
/.fleet
/.idea
/.nova
/.vscode
/.zed
.phpactor.json
Homestead.json
Homestead.yaml

# ── OS files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
